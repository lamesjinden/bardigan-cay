{:deps   {:aliases [:shadow :client :dev :client-tests]}
 :nrepl  {:middleware [cider.piggieback/wrap-cljs-repl]}
 :builds {:app
          {:target     :browser
           :output-dir "resources/public/js"
           :module-loader true
           :modules    {:main {:init-fn wiki.bc.client/init}
                        :graph {:entries [wiki.bc.views.graph]
                                :depends-on #{:main}}
                        :ace {:entries [wiki.bc.ace]
                              :depends-on #{:main}}
                        :editor {:entries [wiki.bc.views.editor]
                                 :depends-on #{:main :ace}}
                        :single-editor {:entries [wiki.bc.views.editor-single]
                                        :depends-on #{:main :ace}}
                        :workspace {:entries [wiki.bc.views.workspace-card]
                                    :depends-on #{:main :graph :ace}}}
           :devtools   {:preloads  [devtools.preload]
                        :watch-dir "resources/public"}
           :build-hooks
           [(shadow.cljs.build-report/hook
             {:output-to "report.html"})]}

          :tests {:target    :node-test
                  :output-to "out/node-tests.js"}}}